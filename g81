#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
build_root="${G81_BUILD_ROOT:-${repo_root}/.work}"
image_name="${G81_BUILD_IMAGE:-g81-android-build:20.04}"
sync_jobs="${G81_SYNC_JOBS:-$(nproc)}"
build_jobs="${G81_BUILD_JOBS:-$(nproc)}"
public_fetch="${G81_PUBLIC_FETCH:-https://github.com/17-Pro-Max-Mini}"
private_fetch="${G81_PRIVATE_FETCH:-ssh://git@github.com/17-Pro-Max-Mini}"

usage() {
    cat <<'EOF'
Usage: ./g81 setup
       ./g81 sync lineage|twrp
       ./g81 build lineage|twrp
       ./g81 validate lineage|twrp
       ./g81 release lineage|twrp
       ./g81 shell lineage|twrp

Default public source:
  G81_PUBLIC_FETCH=https://github.com/17-Pro-Max-Mini
Default private vendor source:
  G81_PRIVATE_FETCH=ssh://git@github.com/17-Pro-Max-Mini
Optional storage override:
  G81_BUILD_ROOT=/path/on/ext4
EOF
}

target_tree() {
    case "$1" in
        lineage) echo "${build_root}/sources/lineage-15.1" ;;
        twrp) echo "${build_root}/sources/twrp-8.1" ;;
        *) echo "Target must be lineage or twrp" >&2; exit 2 ;;
    esac
}

require_image() {
    docker image inspect "${image_name}" >/dev/null 2>&1 || {
        echo "Builder image missing. Run ./g81 setup first." >&2
        exit 1
    }
}

run_builder() {
    local workdir="$1"
    shift
    require_image
    mkdir -p -- "${build_root}/.jack-server/logs"
    docker run --rm --init \
        --volume "${build_root}:${build_root}" \
        --volume "${repo_root}:${repo_root}:ro" \
        --workdir "${workdir}" \
        --env USE_CCACHE=1 \
        --env CCACHE_EXEC=/usr/bin/ccache \
        --env "CCACHE_DIR=${build_root}/ccache" \
        --env "JACK_HOME=${build_root}/.jack-server" \
        --env USER=android \
        --env LOGNAME=android \
        --env "ANDROID_JACK_VM_ARGS=-Xmx4g -Dfile.encoding=UTF-8 -XX:+TieredCompilation -Djava.security.properties=${repo_root}/container/jack-legacy.security" \
        --env "JACK_EXTRA_CURL_OPTIONS=--tlsv1.0 --tls-max 1.0 --ciphers DEFAULT@SECLEVEL=1" \
        "${image_name}" "$@"
}

render_manifest() {
    local template="$1"
    local output="$2"
    local token="$3"
    local value="$4"
    local escaped="${value//&/\\&}"
    sed "s|${token}|${escaped}|g" "${template}" > "${output}"
}

init_tree() {
    local target="$1"
    local tree
    tree="$(target_tree "${target}")"
    [[ -n "${public_fetch}" ]] || { echo "Set G81_PUBLIC_FETCH first." >&2; exit 1; }
    mkdir -p -- "${tree}" "${build_root}/ccache" "${build_root}/releases"

    if [[ "${target}" == lineage ]]; then
        run_builder "${tree}" repo init --no-clone-bundle --git-lfs --repo-rev=stable \
            -u https://github.com/LineageOS/android.git -b lineage-15.1
    else
        run_builder "${tree}" repo init --depth=1 --no-clone-bundle --git-lfs --repo-rev=stable \
            -u https://github.com/minimal-manifest-twrp/platform_manifest_twrp_omni.git -b twrp-8.1
    fi

    mkdir -p -- "${tree}/.repo/local_manifests"
    render_manifest "${repo_root}/manifests/${target}.xml.in" \
        "${tree}/.repo/local_manifests/g81.xml" @G81_PUBLIC_FETCH@ "${public_fetch}"
    if [[ -n "${private_fetch}" ]]; then
        render_manifest "${repo_root}/manifests/private-${target}.xml.in" \
            "${tree}/.repo/local_manifests/g81-private.xml" @G81_PRIVATE_FETCH@ "${private_fetch}"
    else
        unlink "${tree}/.repo/local_manifests/g81-private.xml" 2>/dev/null || true
        echo "Private vendor remote omitted; sync works, but builds need vendor/alps/g81."
    fi
}

sync_target() {
    local target="$1"
    local tree
    tree="$(target_tree "${target}")"
    init_tree "${target}"
    run_builder "${tree}" repo sync -c --no-tags --prune -j "${sync_jobs}"
}

apply_patches() {
    local tree="$1"
    "${tree}/patches/g81/lineage-15.1/apply-patches.sh" "${tree}"
}

build_target() {
    local target="$1"
    local tree
    tree="$(target_tree "${target}")"
    [[ -d "${tree}/.repo" ]] || { echo "Run ./g81 sync ${target} first." >&2; exit 1; }
    [[ -f "${tree}/vendor/alps/g81/proprietary/kernel" ]] || {
        echo "Private vendor inputs are missing at vendor/alps/g81." >&2
        exit 1
    }
    if [[ "${target}" == lineage ]]; then
        apply_patches "${tree}"
        run_builder "${tree}" bash -lc \
            "source build/envsetup.sh; lunch lineage_g81-user; mka bacon systemimage -j${build_jobs}"
    else
        run_builder "${tree}" bash -lc \
            "export ALLOW_MISSING_DEPENDENCIES=true; source build/envsetup.sh; lunch omni_g81-eng; mka recoveryimage -j${build_jobs}"
    fi
}

validate_target() {
    local target="$1"
    local tree
    tree="$(target_tree "${target}")"
    run_builder "${tree}" "${repo_root}/scripts/validate-images.sh" "${target}" "${tree}"
}

release_target() {
    local target="$1"
    local tree release_dir product_out
    tree="$(target_tree "${target}")"
    product_out="${tree}/out/target/product/g81"
    release_dir="${build_root}/releases/${target}-$(date -u +%Y%m%dT%H%M%SZ)"
    validate_target "${target}"
    mkdir -p -- "${release_dir}"
    run_builder "${tree}" repo manifest -r -o "${release_dir}/source-manifest.xml"
    if git -C "${repo_root}" rev-parse --verify HEAD >/dev/null 2>&1; then
        git -C "${repo_root}" rev-parse HEAD > "${release_dir}/ORCHESTRATOR_REVISION"
    fi
    if [[ "${target}" == lineage ]]; then
        install -m 0644 -- "${product_out}/boot.img" "${product_out}/recovery.img" \
            "${product_out}/system.img" "${product_out}/vendor.img" "${release_dir}/"
        find "${product_out}" -maxdepth 1 -type f -name 'lineage-15.1-*-UNOFFICIAL-g81.zip' \
            -exec install -m 0644 -- {} "${release_dir}/" \;
    else
        install -m 0644 -- "${product_out}/recovery.img" "${release_dir}/twrp-8.1-g81.img"
    fi
    (cd "${release_dir}" && sha256sum ./* > SHA256SUMS.txt)
    echo "Release staged at ${release_dir}"
}

command="${1:-}"
target="${2:-}"
case "${command}" in
    setup)
        mkdir -p -- "${build_root}/sources" "${build_root}/ccache" "${build_root}/releases"
        docker build --build-arg "BUILD_UID=$(id -u)" --build-arg "BUILD_GID=$(id -g)" \
            --tag "${image_name}" "${repo_root}/container"
        ;;
    sync) sync_target "${target}" ;;
    build) build_target "${target}" ;;
    validate) validate_target "${target}" ;;
    release) release_target "${target}" ;;
    shell)
        tree="$(target_tree "${target}")"
        require_image
        exec docker run --rm --init --interactive --tty \
            --volume "${build_root}:${build_root}" \
            --volume "${repo_root}:${repo_root}:ro" \
            --workdir "${tree}" "${image_name}" /bin/bash
        ;;
    *) usage; exit 2 ;;
esac
